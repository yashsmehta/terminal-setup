# Group colours when a menu mixes kinds of things: muted palette tones instead of ANSI brights
() {
  local c=$'\e[38;2;'
  zstyle ':fzf-tab:*' group-colors ${c}74\;107\;148m ${c}46\;124\;76m ${c}138\;98\;32m ${c}122\;90\;166m \
    ${c}136\;43\;77m ${c}193\;95\;60m ${c}135\;134\;127m ${c}61\;61\;58m
}
