# Start Claude Code in the palette theme that matches macOS light/dark mode
# (pairs with the Ghostty themes in ~/.config/ghostty/themes). Subcommands pass through.
claude() {
  case "$1" in
    agents|attach|auth|auto-mode|doctor|gateway|import|install|logs|mcp|plugin|plugins|purge|respawn|rm|sessions|setup-token|stop|kill|ultrareview|update|upgrade)
      command claude "$@"; return ;;
  esac
  local theme=light-ansi
  [[ "$(defaults read -g AppleInterfaceStyle 2>/dev/null)" == Dark ]] && theme=dark-ansi
  command claude --settings "{\"theme\":\"$theme\"}" "$@"
}

# Start the Antigravity CLI with all tool permissions auto-approved by default.
# Subcommands (agy update, agy mcp ...) are passed through untouched.
agy() {
  case "$1" in
    acp|agent|agents|changelog|help|install|mcp|mic-serve|models|plugin|plugins|remote-control|update)
      command agy "$@" ;;
    *)
      command agy --dangerously-skip-permissions "$@" ;;
  esac
}

# Run Claude Code, Codex, or Antigravity in a persistent, project-specific tmux session on labgpu2.
# Paths are relative to /home/ymehta3/research.
_remote_research_agent() {
  local tool="$1"
  local project="$2"

  if [[ -z "$project" ]]; then
    echo "Path relative to ~/research/ on labgpu2:"
    read "project?> "
    if [[ -z "$project" ]]; then
      echo "No path provided. Aborting."
      return 1
    fi
  fi

  if [[ "$project" == /* || "$project" == .. || "$project" == ../* || "$project" == */../* || "$project" == */.. ]]; then
    echo "Please provide a path inside ~/research/."
    return 1
  fi

  local remote_dir="/home/ymehta3/research/$project"
  local session="${tool}-${project//\//-}"
  session="${session//[^A-Za-z0-9_-]/-}"

  local launch
  case "$tool" in
    claude)
      launch='claude --continue --dangerously-skip-permissions || claude --dangerously-skip-permissions'
      ;;
    codex)
      launch='codex --dangerously-bypass-approvals-and-sandbox resume --last || codex --dangerously-bypass-approvals-and-sandbox'
      # Remote Codex and Node are provided by nvm in ~/.zshrc.
      launch="zsh -ic ${(q)launch}"
      ;;
    agy)
      launch='command agy --continue --dangerously-skip-permissions || command agy --dangerously-skip-permissions'
      # Load the remote Cloud authentication and PATH settings.
      launch="zsh -ic ${(q)launch}"
      ;;
    *)
      echo "Unknown remote agent: $tool"
      return 1
      ;;
  esac

  ssh -t labgpu2 "remote_dir=${(q)remote_dir}; \
if [ ! -d \"\$remote_dir\" ]; then \
  echo \"Invalid project path: $project\"; \
  echo \"Valid research projects:\"; \
  find /home/ymehta3/research -mindepth 1 -maxdepth 5 -type d -name .git -prune -printf '%h\\n' 2>/dev/null \
    | sed 's|^/home/ymehta3/research/||' \
    | sort; \
  exit 1; \
fi; \
TERM=xterm-256color tmux new-session -A -s ${(q)session} -c \"\$remote_dir\" ${(q)launch}"
}

rclaude() {
  _remote_research_agent claude "$1"
}

rcodex() {
  _remote_research_agent codex "$1"
}

ragy() {
  _remote_research_agent agy "$1"
}

