# One fzf palette for everything (Ctrl-T, Ctrl-R, and the Tab menu): paper background,
# a soft warm highlight for the current row, no gutter bar, thin orange pointer.
_fzf_look=(
  --color=light,fg:#3d3d3a,fg+:#141413:regular,bg+:#efece3,gutter:-1,hl:#c15f3c,hl+:#c15f3c,query:#141413
  --color=prompt:#b0aea5,pointer:#d97757,marker:#2e7c4c,info:#b0aea5,border:#e3e1d6,separator:#e8e6dc
  --color=scrollbar:#dedbd0,header:#87867f,spinner:#d97757,selected-bg:#f4f1ea
  --pointer=▎ --marker=● --gutter=' ' --prompt='❯ ' --info=inline-right --no-separator --highlight-line
)
